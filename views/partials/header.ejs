            } else {
              div.className += " toastify-right";
            }
          }
          div.className += " " + this.options.gravity;

          for (const property in this.options.style) {
            div.style[property] = this.options.style[property];
          }

          if (this.options.node && this.options.node.nodeType === Node.ELEMENT_NODE) {
            div.appendChild(this.options.node)
          } else {
            if (this.options.escapeMarkup) {
              div.innerText = this.options.text;
            } else {
              div.innerHTML = this.options.text;
            }
            if (this.options.avatar !== "") {
              var avatar = document.createElement("img");
              avatar.src = this.options.avatar;
              avatar.className = "toastify-avatar";
              if (this.options.position == "left" || this.options.positionLeft === true) {
                div.appendChild(avatar);
              } else {
                div.insertAdjacentElement("afterbegin", avatar);
              }
            }
          }

          if (this.options.close === true) {
            var close = document.createElement("span");
            close.innerHTML = "&#10006;";
            close.className = "toast-close";
            close.addEventListener("click", function(e) {
              e.stopPropagation();
              this.removeElement(this.toastElement);
              window.clearTimeout(this.toastElement.timeOutValue);
            }.bind(this));
            var width = window.innerWidth > 0 ? window.innerWidth : screen.width;
            if ((this.options.position == "left" || this.options.positionLeft === true) && width > 360) {
              div.insertAdjacentElement("afterbegin", close);
            } else {
              div.appendChild(close);
            }
          }

          if (this.options.stopOnFocus && this.options.duration > 0) {
            var self = this;
            div.addEventListener("mouseover", function() {
              window.clearTimeout(div.timeOutValue);
            });
            div.addEventListener("mouseleave", function() {
              div.timeOutValue = window.setTimeout(function() {
                self.removeElement(div);
              }, self.options.duration);
            });
          }

          if (typeof this.options.destination !== "undefined") {
            div.addEventListener("click", function(e) {
              e.stopPropagation();
              if (this.options.newWindow === true) {
                window.open(this.options.destination, "_blank");
              } else {
                window.location = this.options.destination;
              }
            }.bind(this));
          }

          if (typeof this.options.onClick === "function" && typeof this.options.destination === "undefined") {
            div.addEventListener("click", function(e) {
              e.stopPropagation();
              this.options.onClick();
            }.bind(this));
          }

          if (typeof this.options.offset === "object") {
            var x = getAxisOffsetAValue("x", this.options);
            var y = getAxisOffsetAValue("y", this.options);
            var xOffset = this.options.position == "left" ? x : "-" + x;
            var yOffset = this.options.gravity == "toastify-top" ? y : "-" + y;
            div.style.transform = "translate(" + xOffset + "," + yOffset + ")";
          }

          return div;
        },

        showToast: function() {
          this.toastElement = this.buildToast();
          var root = typeof this.options.selector === "string" ? document.getElementById(this.options.selector) :
            (this.options.selector instanceof HTMLElement || this.options.selector instanceof ShadowRoot) ?
            this.options.selector : document.body;
          if (!root) throw "Root element is not defined";
          var target = Toastify.defaults.oldestFirst ? root.firstChild : root.lastChild;
          root.insertBefore(this.toastElement, target);
          Toastify.reposition();

          if (this.options.duration > 0) {
            this.toastElement.timeOutValue = window.setTimeout(function() {
              this.removeElement(this.toastElement);
            }.bind(this), this.options.duration);
          }
          return this;
        },

        hideToast: function() {
          if (this.toastElement.timeOutValue) {
            clearTimeout(this.toastElement.timeOutValue);
          }
          this.removeElement(this.toastElement);
        },

        removeElement: function(elem) {
          elem.className = elem.className.replace(" on", "");
          window.setTimeout(function() {
            if (this.options.node && this.options.node.parentNode) {
              this.options.node.parentNode.removeChild(this.options.node);
            }
            if (elem.parentNode) {
              elem.parentNode.removeChild(elem);
            }
            this.options.callback.call(elem);
            Toastify.reposition();
          }.bind(this), 400);
        },
      };

      Toastify.reposition = function() {
        var topLeft = {
            top: 15,
            bottom: 15
          },
          topRight = {
            top: 15,
            bottom: 15
          },
          center = {
            top: 15,
            bottom: 15
          };
        var allToasts = document.getElementsByClassName("toastify"),
          classUsed;
        for (var i = 0; i < allToasts.length; i++) {
          classUsed = containsClass(allToasts[i], "toastify-top") ? "toastify-top" : "toastify-bottom";
          var height = allToasts[i].offsetHeight;
          classUsed = classUsed.substring(9);
          var offset = 15,
            width = window.innerWidth > 0 ? window.innerWidth : screen.width;
          if (width <= 360) {
            allToasts[i].style[classUsed] = center[classUsed] + "px";
            center[classUsed] += height + offset;
          } else {
            if (containsClass(allToasts[i], "toastify-left")) {
              allToasts[i].style[classUsed] = topLeft[classUsed] + "px";
              topLeft[classUsed] += height + offset;
            } else {
              allToasts[i].style[classUsed] = topRight[classUsed] + "px";
              topRight[classUsed] += height + offset;
            }
          }
        }
        return this;
      };

      function getAxisOffsetAValue(axis, options) {
        if (options.offset[axis]) {
          return isNaN(options.offset[axis]) ? options.offset[axis] : options.offset[axis] + 'px';
        }
        return '0px';
      }

      function containsClass(elem, yourClass) {
        if (!elem || typeof yourClass !== "string") return false;
        return elem.className && elem.className.trim().split(/\s+/gi).indexOf(yourClass) > -1;
      }

      Toastify.lib.init.prototype = Toastify.lib;
      return Toastify;
    });
  </script>


  <script>
    //TOAST
    const logoutToast = Toastify({
      text: "You are being logged out",
      duration: 1000
    })
    const logout = () => {
      fetch("/", {
        method: "DELETE",
      });
      logoutToast.showToast();
      setTimeout(() => {
        window.location.replace("/");
      }, 1000);
    }
  </script>
